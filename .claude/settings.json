{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/allow_enqueue.py",
              "--sha256",
              "50718a5a07283a72dc5a15e5fa17b239a495a2856786305e3e5f01d3870b20b5"
            ],
            "command": "python3",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check.py"
            ],
            "command": "python3",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "v1.3.2"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "permissions": {
    "allow": [],
    "ask": [
      "Bash(gh api *PullRequestAutoMerge*)",
      "Bash(gh api */merge*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *iX*)",
      "Bash(gh api *=@*)",
      "Bash(gh api *--input*)",
      "Bash(gh api */secrets*)",
      "Bash(gh api */variables*)",
      "Bash(gh api */hooks*)",
      "Bash(gh api */keys*)",
      "Bash(gh api */collaborators*)",
      "Bash(gh api */invitations*)",
      "Bash(gh api */actions/permissions*)",
      "Bash(gh api */environments*)",
      "Bash(gh api */transfer*)",
      "Bash(gh api *Repository*)",
      "Bash(gh api *BranchProtection*)",
      "Bash(gh api *Ruleset*)",
      "Bash(gh api *mergeBranch*)",
      "Bash(gh api *Environment*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/.env*/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *allow_*merge*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh secret *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *enqueuePullRequest*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "Bash(*baseline.py*github*apply*)",
      "Read(.env*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Bash(git push * *:main)",
      "Bash(git push * +main)",
      "Bash(gh pr merge)",
      "Bash(git push)"
    ]
  }
}
